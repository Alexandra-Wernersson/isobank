# One step of tuning.dag. Edit the five lines below before submitting.
isobank   = /project/<group>/<user>/isobank
mbank     = /project/<group>/<user>/mbank
conda_env = /data/gravwav/lopezm/cmb_env/miniforge3/envs/isobank-mbank
work      = /data/gravwav/lopezm/mbank_tuning
group     = <your accounting group, from `id`>

executable       = $(isobank)/mbank_comparison/tuning/step.sh
arguments        = $(step) $(name) $(isobank) $(mbank) $(conda_env) $(work)
initialdir       = $(isobank)/mbank_comparison/tuning
output           = $(work)/logs/$(step)_$(name).out
error            = $(work)/logs/$(step)_$(name).err
log              = $(work)/logs/condor.log
request_cpus     = 1
request_memory   = 8G
accounting_group = $(group)
+UseOS           = "el9"
+JobCategory     = "$(category)"
queue

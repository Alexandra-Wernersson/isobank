# One step of comparison.dag. Check the paths below before submitting.
repo      = /data/gravwav/lopezm/Projects/isobank
conda_env = /data/gravwav/lopezm/cmb_env/miniforge3/envs/isobank
# placement radius in units of r_target (calibrated from the config's MU); 1.0 as scripts/generate_bank.py
radius    = 1.0

executable       = $(repo)/autoencoder_comparison/nikhef/step.sh
arguments        = $(step) $(repo) $(conda_env) $(radius)
initialdir       = $(repo)
output           = $(repo)/logs/$(step).out
error            = $(repo)/logs/$(step).err
log              = $(repo)/logs/condor.log
request_cpus     = 1
request_memory   = $(memory)
+UseOS           = "el9"
+JobCategory     = "$(category)"
queue
